[Unit]
Description=hypr-rdp for the headless remote session (localhost:3390, behind rdp-gate)
BindsTo=hyprland-remote.service
After=hyprland-remote.service

[Service]
Type=simple
ExecStart=%h/.config/hypr-rdp/hypr-rdp-remote.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=hyprland-remote.service
