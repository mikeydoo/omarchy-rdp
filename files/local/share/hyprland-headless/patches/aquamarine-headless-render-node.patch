+// Headless-only mode (opt-in): when AQ_HEADLESS_RENDER_NODE names a DRM render node
+// (e.g. /dev/dri/renderD128), the headless backend exposes it as its DRM fd so that
+// CBackend can create a GBM allocator and the compositor can render on the GPU with no
+// DRM/Wayland backend and no seat. Render nodes need no DRM master or logind session.
+// File-static on purpose: keeps CHeadlessBackend's layout (and the library ABI) unchanged.
+static int g_headlessRenderNodeFD = -2; // -2: not opened yet, -1: unset or failed
+
+static int headlessRenderNodeFD() {
+    if (g_headlessRenderNodeFD != -2)
+        return g_headlessRenderNodeFD;
+
+    g_headlessRenderNodeFD = -1;
+    const char* path       = getenv("AQ_HEADLESS_RENDER_NODE");
+    if (path && *path)
+        g_headlessRenderNodeFD = open(path, O_RDWR | O_CLOEXEC);
+    return g_headlessRenderNodeFD;
+}
+
